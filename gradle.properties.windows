# ⚠️ IMPORTANT FOR WINDOWS USERS

# If you're on Windows, uncomment the line below and set your Java 21 path:
# org.gradle.java.home=C:\Program Files\Java\jdk-21.x.x

# Example paths where Java 21 might be installed:
# - C:\Program Files\Java\jdk-21.0.10 (if installed from Oracle)
# - C:\Users\User\scoop\apps\openjdk21\current (if using Scoop)
# - C:\Program Files\Eclipse Foundation\jdk-21.0.x (if using Eclipse Temurin)

# To find your Java 21 path on Windows, run in Command Prompt:
# where java
# java -version
# echo %JAVA_HOME%

# Then replace the path below with your actual Java 21 installation:
# org.gradle.java.home=C:\Program Files\Java\jdk-21.0.10

# After setting, save this file and restart IntelliJ IDEA
